# autofines: штрафы МВД Грузии по госномеру → Telegram.
# Как включить — в README, раздел «Установка на роутер».

config autofines 'main'
	option enabled '0'
	# Токен бота от @BotFather и id чата, куда слать.
	option bot_token ''
	option chat_id ''
	# Госномера латиницей, слитно, без кода страны, по строке на номер.
	list plate 'AB123CD'
	# Раз во сколько минут проверять.
	option interval '60'
	# Напоминать, когда до конца срока оплаты осталось столько дней; 0 — не напоминать.
	option remind_days '7'
	# 1 — каждая проверка присылает все текущие штрафы, а не только новые.
	option notify_always '0'
	# 1 — каждая проверка присылает «неоплаченных нет», то есть раз в interval минут.
	option notify_empty '0'
